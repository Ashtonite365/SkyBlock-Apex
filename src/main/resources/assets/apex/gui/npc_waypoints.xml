<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://notenoughupdates.org/moulconfig" xmlns:apex="http://apex.ashtonite365.dev/moulconfig">
	<Center>
		<Panel background="VANILLA" insets="5">
			<Column>
				<Center>
					<TextField value="@search" width="200"/>
				</Center>
				<apex:Tick tick="@tick"/>
				<Spacer height="5"/>
				<Panel background="TRANSPARENT" insets="4">
					<ScrollPanel width="200" height="300">
						<Array data="@results">
							<Row>
								<Text text="@name" width="180"/>
								<apex:Hover lines="Click to set this waypoint as your destination;Shift-Click to warp to the nearest warp point and set this as your destination">
									<apex:Button onClick="@click" noBackground="true">
										<When condition="@isSelected">
											<apex:Image resource="apex:textures/gui/waypoint_selected.png" width="16" height="16"/>
											<apex:Image resource="apex:textures/gui/waypoint_unselected.png" width="16" height="16"/>
										</When>
									</apex:Button>
								</apex:Hover>
							</Row>
						</Array>
					</ScrollPanel>
				</Panel>
			</Column>
		</Panel>
	</Center>
</Root>
